# Purpose: Project-wide pylint configuration tuned for Health-Records-Collection.
# Author: Codex + Lauren
# Date: 2025-10-29
# Related tests: .github/workflows/quality-checks.yml lint-and-test job
# AI-assisted: Generated with AI support (GPT-5 Codex)

[MASTER]
ignore=.venv,build,dist,data,docs/_build
extension-pkg-allow-list=lxml,defusedxml
load-plugins=pylint.extensions.docparams,pylint.extensions.mccabe
jobs=0
persistent=yes

[MESSAGES CONTROL]
enable=useless-suppression
disable=
    C0111,  # missing-docstring
    C0103,  # invalid-name
    C0303,  # trailing-whitespace
    W0511,  # fixme
    W0105,  # pointless-string-statement
    R0903,  # too-few-public-methods
    C0301   # line-too-long (handled by black)

[REPORTS]
reports=no
score=yes

[BASIC]
good-names=id,ns,db,pk,dt,fn
docstring-min-length=10
allow-any-import-level=no
bad-names=foo,bar,baz,todo,fixme,data,temp

[FORMAT]
max-line-length=88
max-module-lines=1200
indent-string='    '

[LOGGING]
logging-format-style=old
logging-modules=logging

[TYPECHECK]
ignored-modules=settings,db.schema,security.encryption
ignored-classes=etree._Element,etree._ElementTree

[DESIGN]
max-args=10
max-attributes=12
max-locals=25
max-branches=15
max-statements=100
max-returns=10

[SIMILARITIES]
min-similarity-lines=6
ignore-comments=yes
ignore-docstrings=yes
ignore-imports=yes

[MISCELLANEOUS]
notes=FIXME,XXX,TODO,SECURITY
